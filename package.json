{
  "name": "mandragora-qa-test-manager",
  "version": "1.0.0",
  "description": "Admin SPA for the Mandragora QA Test Manager WordPress plugin.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode debug",
    "build": "vite build",
    "lint": "eslint src",
    "format": "prettier --write src",
    "release": "bin/build-release.sh",
    "make-pot": "wp i18n make-pot . languages/mandragora-qa-test-manager.pot --domain=mandragora-qa-test-manager --exclude=src,dist,node_modules,vendor,bin"
  },
  "dependencies": {
    "@vueup/vue-quill": "^1.5.5",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5"
  },
  "type": "module"
}
